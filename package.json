{
  "name": "stax-protocol",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:local": "hardhat test mocha test/StaxVault.test.ts test/StaxVaultV2.local.test.ts test/StaxVaultV2.audit.test.ts",
    "test:v2": "hardhat test mocha test/StaxVaultV2.local.test.ts",
    "streams-keeper": "node scripts/monitor/streams-keeper.mjs",
    "test:streams": "hardhat test mocha test/StreamsRegistryAdapter.test.ts",
    "test:userbasket": "node scripts/onboarding/test-broadcaster.mjs userbasket",
    "fork:userbasket": "hardhat run scripts/assessment/userbasket-fork.ts",
    "userbasket:deploy": "node --experimental-strip-types scripts/onboarding/deploy-userbasket-factory.ts",
    "userbasket:verify": "node scripts/onboarding/verify-userbasket-factory.mjs",
    "userbasket:verify:blockscout": "node scripts/onboarding/verify-userbasket-blockscout.mjs",
    "prospect": "node scripts/assessment/prospect-tokens.mjs",
    "onboard:batch": "node scripts/onboarding/onboard-batch.mjs",
    "monitor": "node scripts/monitor/basket-monitor.mjs",
    "heartbeat": "node scripts/monitor/heartbeat.mjs",
    "e2e": "hardhat run scripts/e2e/flows.ts",
    "test:audit": "hardhat test mocha test/StaxVaultV2.audit.test.ts",
    "typecheck:v2": "tsc --project tsconfig.v2-tests.json",
    "onboard:plan": "node --experimental-strip-types scripts/onboarding/plan-token.ts",
    "onboard:broadcast": "node --experimental-strip-types scripts/onboarding/broadcast-token.ts",
    "basket:pause": "node --experimental-strip-types scripts/onboarding/pause-basket.ts",
    "registry:floor": "node --experimental-strip-types scripts/onboarding/registry-floor.ts",
    "test:broadcaster": "node scripts/onboarding/test-broadcaster.mjs",
    "test:invariant:v2": "hardhat test solidity --config hardhat.invariant.config.ts test/invariant/StaxVaultV2.invariant.t.sol",
    "test:invariant:v1": "hardhat test solidity --config hardhat.invariant.config.ts test/invariant/StaxVault.invariant.t.sol",
    "typecheck:onboarding": "tsc --project tsconfig.onboarding.json",
    "onboard": "node --experimental-strip-types scripts/onboarding/onboard-token.ts",
    "typecheck:assessment": "tsc --project tsconfig.assessment.json",
    "verify:deployed": "node scripts/assessment/verify-deployed.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuvex/stax-protocol.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ryuvex/stax-protocol/issues"
  },
  "homepage": "https://github.com/ryuvex/stax-protocol#readme",
  "description": "",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-verify": "^3.0.22",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v4-core": "^1.0.2",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.11.1",
    "mocha": "^11.7.6",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^17.4.2"
  }
}
