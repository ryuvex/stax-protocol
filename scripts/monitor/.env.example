STAX_RPC_URL=https://rpc.mainnet.chain.robinhood.com
STAX_MONITOR_INTERVAL_SEC=120
# Slack — pick ONE:
# (a) incoming webhook
#STAX_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# (b) non-expiring bot token
#STAX_SLACK_BOT_TOKEN=xoxb-...
#STAX_SLACK_CHANNEL=C0XXXXXXX
# (c) rotating OAuth token: access/refresh tokens in .slack-tokens.local.json (gitignored) + app credentials here
#STAX_SLACK_CLIENT_ID=...
#STAX_SLACK_CLIENT_SECRET=...
#STAX_SLACK_CHANNEL=C0XXXXXXX

# --- Chainlink Data Streams keeper (scripts/monitor/streams-keeper.mjs) ---
STAX_STREAMS_ADAPTER=0x0000000000000000000000000000000000000000
STAX_STREAMS_API_KEY=
STAX_STREAMS_API_SECRET=
STAX_STREAMS_API_URL=https://api.dataengine.chain.link
# [{"symbol":"NFLX","token":"0xE0444EF8BF4eD74f74FD73686e2ddF4C1c5591E8","feedId":"0x..."}]
STAX_STREAMS_TOKENS=[]
STAX_STREAMS_EVERY_SEC=300
STAX_STREAMS_MAX_AGE_SEC=240
